    return `<div class="stepper"><button data-dec="${key}" data-p="${k}" aria-label="Restar ${words[key]} a ${esc(name)}">−</button><span class="v">${val}</span><button data-inc="${key}" data-p="${k}" aria-label="Sumar ${words[key]} a ${esc(name)}">+</button></div>`;
