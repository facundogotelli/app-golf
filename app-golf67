      let cands = [];
      if (tap) {
        setPhase("Buscando el momento del golpe…");
        const S = { x: tap.x * G.W, y: tap.y * G.H };
        const tImp = await impactFromTap(v, G, S, tap.t);
        if (tImp !== null) cands = [{ S, tImp }];
      } else {
        setPhase("Escuchando el golpe…");
        const tA = await impactFromAudio(t.file);
        setPhase("Buscando la pelota…");
        if (tA !== null) cands = await ballAtImpact(v, G, tA);
        if (!cands.length) cands = await ballAndImpactVisual(v, G, setProg) || [];
      }
      if (t.cancel) return;
      if (!cands.length) {
        t.auto = { state: tap ? "fail" : "needtap", info: "No encontré la pelota quieta en el piso." };
        await seekTo(v, Math.min(v.duration * 0.3, 2)); updateTracerUI(); return;
      }
      setPhase("Siguiendo la pelota…");
      const fps = await estimateFps(v, Math.max(0, cands[0].tImp - 0.6));
      let pts = null, S = null, tImp = null;
      for (const c of cands) {
        dbg("prueba S", c.S, "tImp", c.tImp, "fps", fps, "W", G.W, "H", G.H);
        pts = await trackFlight(v, G, c.S, c.tImp, fps, setProg);
        if (t.cancel) return;
        if (pts && pts.length >= 5) { S = c.S; tImp = c.tImp; break; }
      }
      if (!pts || pts.length < 5) {
        t.auto = { state: tap ? "fail" : "needtap", info: "Encontré el golpe pero no pude seguir la pelota." };
        await seekTo(v, Math.max(0, tImp - 0.5)); updateTracerUI(); return;
      }
      const res = buildPath(pts, G.W, G.H);
      Object.assign(t, { path: res.path, t0: tImp, t2: res.tEnd, step: 3, auto: { state: "ok", seen: res.seen, est: res.est } });
      await seekTo(v, Math.max(0, tImp - 0.8));
    } catch (err) {
      t.auto = { state: "fail" };
    }
    updateTracerUI();
  }

  /* ---------- Pantalla del video ---------- */
  function setupTracer() {
    const t = state.tracer;
    const onFile = (e) => {
      const f = e.target.files && e.target.files[0]; if (!f) return;
      if (t.url) URL.revokeObjectURL(t.url);
      if (t.exportUrl) URL.revokeObjectURL(t.exportUrl);
      t.cancel = true;
      state.tracer = Object.assign(newTracer(), { url: URL.createObjectURL(f), file: f, name: f.name });
      render();
    };
    if ($("#tr-file")) $("#tr-file").addEventListener("change", onFile);
    if ($("#tr-file2")) $("#tr-file2").addEventListener("change", onFile);
    const v = $("#tr-video"); if (!v) return;
    const stage = $("#tr-stage"), cv = $("#tr-canvas"), seek = $("#tr-seek"), time = $("#tr-time"), play = $("#tr-play");
    const busy = () => t.auto.state === "running" || t.busy;
    const fit = () => {
      if (!v.videoWidth) return;
      const ar = v.videoWidth / v.videoHeight;
      const maxH = Math.min(window.innerHeight * 0.62, 640);
      stage.style.aspectRatio = `${v.videoWidth} / ${v.videoHeight}`;
      stage.style.width = Math.min(stage.parentElement.clientWidth, maxH * ar) + "px";
      const r = stage.getBoundingClientRect(), dpr = window.devicePixelRatio || 1;
      cv.width = Math.round(r.width * dpr); cv.height = Math.round(r.height * dpr);
    };
    v.addEventListener("loadedmetadata", () => {
      fit(); seek.max = v.duration || 1;
      if (t.auto.state === "idle") runAuto();
      else v.currentTime = t.path || t.step > 0 ? Math.max(0, t.t0 - 0.8) : 0;
    }, { once: true });
    window.addEventListener("resize", fit);
    seek.addEventListener("input", () => { if (busy()) return; v.pause(); v.currentTime = +seek.value; });
    play.addEventListener("click", () => {
      if (busy()) return;
      const ready = t.path || (t.mode === "manual" && t.step >= 3);
      if (v.paused) { if (ready && (v.currentTime >= t.t2 + 1 || v.currentTime < t.t0 - 1.5)) v.currentTime = Math.max(0, t.t0 - 0.8); v.play(); } else v.pause();
    });
    v.addEventListener("play", () => { play.textContent = "❚❚"; play.setAttribute("aria-label", "Pausar"); });
    v.addEventListener("pause", () => { play.textContent = "▶"; play.setAttribute("aria-label", "Reproducir"); });
    const step = (d) => { if (busy()) return; v.pause(); v.currentTime = Math.max(0, Math.min(v.duration || 0, v.currentTime + d)); };
    $("#tr-prev").addEventListener("click", () => step(-1 / 30));
    $("#tr-next").addEventListener("click", () => step(1 / 30));
    cv.addEventListener("pointerdown", (e) => {
      if (busy()) return;
      const r = cv.getBoundingClientRect();
      const p = { x: (e.clientX - r.left) / r.width, y: (e.clientY - r.top) / r.height };
      if (t.mode === "auto" && t.auto.state === "needtap") { v.pause(); runAuto({ ...p, t: v.currentTime }); return; }
      if (t.mode !== "manual" || t.step >= 3) return;
      if (t.step === 0) { t.p0 = p; t.t0 = v.currentTime; }
      else if (t.step === 1) t.p1 = p;
      else { t.p2 = p; t.t2 = v.currentTime > t.t0 + 0.3 ? v.currentTime : t.t0 + 2.5; }
      t.step++;
      if (t.step === 3) { v.pause(); v.currentTime = Math.max(0, t.t0 - 0.8); }
      updateTracerUI();
    });
    const loop = () => {
      const ctx = cv.getContext("2d");
      ctx.clearRect(0, 0, cv.width, cv.height);
      if (t.auto.state !== "running") drawTrace(ctx, cv.width, cv.height, t, v.currentTime, { clean: !v.paused });
      if (document.activeElement !== seek) seek.value = v.currentTime;
      time.textContent = v.currentTime.toFixed(2).replace(".", ",");
      tracerRaf = requestAnimationFrame(loop);
    };
    loop();
  }
  // Arma un video nuevo con la línea dibujada (todo en el celular)
  async function exportTracer() {
    const t = state.tracer, v = $("#tr-video");
    if (!(t.path || (t.mode === "manual" && t.step >= 3))) return;
    if (!v || !window.MediaRecorder) { t.msg = "Este navegador no puede armar videos. Probá con Chrome o con Safari actualizado."; updateTracerUI(); return; }
    const types = ["video/mp4;codecs=avc1", "video/mp4", "video/webm;codecs=vp9", "video/webm"];
    const mime = types.find((x) => MediaRecorder.isTypeSupported(x));
    const scale = Math.min(1, 1280 / Math.max(v.videoWidth, v.videoHeight));
    const out = document.createElement("canvas");
    out.width = Math.round(v.videoWidth * scale / 2) * 2; out.height = Math.round(v.videoHeight * scale / 2) * 2;
    if (!out.captureStream) { t.msg = "Este navegador no puede armar videos. Probá con Chrome o con Safari actualizado."; updateTracerUI(); return; }
    t.busy = true; t.msg = ""; if (t.exportUrl) { URL.revokeObjectURL(t.exportUrl); t.exportUrl = null; }
    updateTracerUI();
    const vid = v, prog = $("#tr-prog");
    const ctx = out.getContext("2d");
    const start = Math.max(0, t.t0 - 1), end = Math.min(vid.duration || t.t2 + 1.5, t.t2 + 1.5);
    vid.pause();
    await new Promise((res) => { vid.addEventListener("seeked", res, { once: true }); vid.currentTime = start; });
    const rec = new MediaRecorder(out.captureStream(30), mime ? { mimeType: mime, videoBitsPerSecond: 6e6 } : undefined);
    const chunks = []; rec.ondataavailable = (e) => { if (e.data && e.data.size) chunks.push(e.data); };
    const done = new Promise((res) => { rec.onstop = res; });
    rec.start(250);
    await vid.play();
    await new Promise((res) => {
      const frame = () => {
        ctx.drawImage(vid, 0, 0, out.width, out.height);
        drawTrace(ctx, out.width, out.height, t, vid.currentTime, { clean: true });
        if (prog) prog.style.width = Math.min(100, 100 * (vid.currentTime - start) / (end - start)) + "%";
        if (vid.currentTime >= end || vid.ended || vid.paused) return res();
        requestAnimationFrame(frame);
      };
      frame();
    });
    vid.pause(); rec.stop(); await done;
    const type = (rec.mimeType || mime || "video/webm").split(";")[0];
    const blob = new Blob(chunks, { type });
    state.tracer.exportBlob = blob;
    state.tracer.exportType = type.includes("mp4") ? "mp4" : "webm";
    state.tracer.exportUrl = URL.createObjectURL(blob);
    state.tracer.busy = false;
    state.tracer.msg = blob.size ? "Video listo." : "No se pudo armar el video. Probá de nuevo.";
    updateTracerUI();
  }
  async function shareTracer() {
    const t = state.tracer;
    try {
      const file = new File([t.exportBlob], `tiro-con-trayectoria.${t.exportType}`, { type: t.exportBlob.type });
      if (navigator.canShare && navigator.canShare({ files: [file] })) await navigator.share({ files: [file], title: "Mi tiro" });
      else { t.msg = "Este celular no permite compartir el video desde acá. Usá «Descargar video»."; updateTracerUI(); }
    } catch (e) { /* el usuario canceló */ }
  }

  /* ================= Actualización en vivo (GPS) ================= */
  function updateLive() {
    const st = $("#gps-status");
    if (!st) return;
    const msgs = {
      idle: `<span class="dot"></span>Buscando GPS…`,
      on: `<span class="dot on"></span>GPS ±${state.pos ? Math.round(state.pos.acc || 0) : "?"} m`,
      denied: `<span class="dot off"></span>Ubicación bloqueada`,
      unavailable: `<span class="dot off"></span>GPS no disponible`,
    };
    st.innerHTML = msgs[state.gps];
    const r = activeRound(), c = courseOf(r), i = state.hole, g = c.greens[i], poly = c.greenPolys[i];
    const set = (id, v) => { const el = $(id); if (el) el.textContent = v; };
    if (g && state.pos) {
      const d = distanceM(state.pos, g);
      // Con contorno del mapa: frente y fondo reales. Sin contorno: ±12 m del centro (un green típico mide unos 25 m de largo)
      const fb = poly ? polyFrontBack(state.pos, poly) : { front: Math.max(0, d - 12), back: d + 12 };
      set("#d-center", yd(d)); set("#d-front", yd(fb.front)); set("#d-back", yd(fb.back));
    } else { set("#d-center", "–"); set("#d-front", "–"); set("#d-back", "–"); }
    const note = $("#map-note");
    if (note && (state.gps === "denied" || state.gps === "unavailable") && !tilesFailed) {
      note.textContent = state.gps === "denied"
        ? "Para ver distancias, permití el acceso a la ubicación en la configuración del celular y recargá la página."
        : "El GPS no funciona en esta vista. Abrí tu link de GitHub desde Safari o Chrome en el celular.";
    }
    const btnShot = $("#btn-shot"), btnHere = $("#btn-green-here");
    if (btnShot) btnShot.disabled = !state.pos;
    if (btnHere) btnHere.disabled = !state.pos;
    drawMap();
  }

  /* ================= Eventos ================= */
  document.addEventListener("submit", (e) => e.preventDefault());
  document.addEventListener("input", (e) => {
    const t = e.target;
    if (t.dataset.guest !== undefined) {
      const g = state.guests[+t.dataset.guest];
      if (t.dataset.key === "name") g.name = t.value; else g.handicap = parseNum(t.value);
    }
    if (t.id === "course-filter") { state.cat.filter = t.value; state.cat.showAll = false; renderCourseList(); }
  });
  document.addEventListener("click", (e) => {
    const t = e.target.closest("button");
    if (!t) return;
    const r = activeRound();
    if (t.dataset.tab) { state.tab = t.dataset.tab; state.view = "main"; render(); return; }
    if (t.dataset.inc || t.dataset.dec) {
      const key = t.dataset.inc || t.dataset.dec, h = r.players[+t.dataset.p].holes[state.hole];
      h[key] = Math.max(0, h[key] + (t.dataset.inc ? 1 : -1));
      if (key === "putts" && h.putts > h.strokes) h.strokes = h.putts;
      if (key === "strokes" && h.putts > h.strokes) h.putts = h.strokes;
      save(); render(); return;
    }
    if (t.dataset.sel !== undefined) { state.sel = +t.dataset.sel; render(); return; }
    if (t.dataset.fw !== undefined) {
      const h = r.players[state.sel].holes[state.hole], v = t.dataset.fw === "1";
      h.fairway = h.fairway === v ? null : v; save(); render(); return;
    }
    if (t.dataset.removeGuest !== undefined) { state.guests.splice(+t.dataset.removeGuest, 1); render(); return; }
    if (t.dataset.pick !== undefined) { const it = state.cat.items.find((x) => x.key === t.dataset.pick); if (it) pickCatalogCourse(it); return; }
    if (t.dataset.pickSaved !== undefined) { state.cat.msg = ""; selectCourse(t.dataset.pickSaved); return; }
    if (t.dataset.mapmode) { state.data.prefs.mapMode = t.dataset.mapmode; save(); render(); return; }
    if (t.dataset.color) { state.data.prefs.traceColor = t.dataset.color; save(); document.querySelectorAll(".swatches button").forEach((b) => b.setAttribute("aria-pressed", b.dataset.color === t.dataset.color)); return; }
    switch (t.id) {
      case "btn-add-guest": state.guests.push({ name: "", handicap: null }); render(); { const inp = $(`#g-name-${state.guests.length - 1}`); if (inp) inp.focus(); } break;
      case "btn-change-course": state.changingCourse = true; state.cat.msg = ""; render(); { const f = $("#course-filter"); if (f) f.focus(); } break;
      case "btn-keep-course": state.changingCourse = false; render(); break;
      case "btn-more": state.cat.showAll = true; renderCourseList(); break;
      case "btn-cat-retry": loadCatalog(true); break;
      case "btn-fly": flyHole(); break;
      case "btn-overview": frameHole(true); break;
      case "btn-tracer": state.view = "tracer"; state.tracer = state.tracer || newTracer(); render(); window.scrollTo(0, 0); break;
      case "tr-back": if (state.tracer) state.tracer.cancel = true; state.view = "main"; render(); break;
      case "tr-reset": Object.assign(state.tracer, { step: 0, p0: null, p1: null, p2: null }); updateTracerUI(); break;
      case "tr-manual": Object.assign(state.tracer, { mode: "manual", step: 0, p0: null, p1: null, p2: null, cancel: true }); state.tracer.auto.state = "manual"; updateTracerUI(); break;
      case "tr-auto": runAuto(); break;
      case "tr-cancel": state.tracer.cancel = true; state.tracer.auto = { state: "needtap", info: "Cancelaste la búsqueda." }; updateTracerUI(); break;
      case "tr-export": exportTracer(); break;
      case "tr-share": shareTracer(); break;
      case "btn-close-results": state.lastFinished = null; render(); break;
      case "btn-new-course": state.showNewCourse = !state.showNewCourse; render(); break;
      case "btn-save-course": {
        const name = $("#nc-name").value.trim() || "Cancha sin nombre";
        const course = { id: uid(), name, pars: state.newCoursePars.slice(), rating: parseNum($("#nc-rating").value), slope: parseInt($("#nc-slope").value, 10) || null, greens: {}, greenPolys: {}, holeLines: {}, source: "manual", osm: state.newCourseOsm || null };
        state.data.courses.push(course); state.selectCourseId = course.id; state.changingCourse = false; state.cat.msg = "";
        state.showNewCourse = false; state.newCourseName = ""; state.newCoursePars = null; state.newCourseOsm = null;
        save(); render(); break;
      }
      case "btn-start": {
        const c = state.data.courses.find((x) => x.id === state.selectCourseId);
        if (!c) break;
        const prof = state.data.profile;
        const blank = () => c.pars.map(() => ({ strokes: 0, putts: 0, penalties: 0, fairway: null, shots: [] }));
        const players = [{ id: "me", name: prof.name || "Vos", handicap: prof.handicap, isMe: true, holes: blank() }]
          .concat(state.guests.map((g, k) => ({ id: uid(), name: g.name.trim() || `Jugador ${k + 2}`, handicap: g.handicap ?? 0, isMe: false, holes: blank() })));
        const round = { id: uid(), courseId: c.id, date: new Date().toISOString(), done: false, players };
        state.data.rounds.push(round); state.data.activeRoundId = round.id; state.hole = 0; state.sel = 0; state.lastFinished = null;
        save(); render(); break;
      }
      case "prev": state.hole = Math.max(0, state.hole - 1); state.setGreenMode = false; render(); break;
      case "next": state.hole = Math.min(courseOf(r).pars.length - 1, state.hole + 1); state.setGreenMode = false; render(); break;
      case "btn-green": state.setGreenMode = !state.setGreenMode; render(); break;
      case "btn-green-here":
        if (state.pos) { const c = courseOf(r); delete c.greenPolys[state.hole]; c.greens[state.hole] = { lat: state.pos.lat, lng: state.pos.lng }; save(); render(); }
        break;
      case "btn-shot": {
        if (!state.pos) break;
        const h = r.players[state.sel].holes[state.hole];
        h.shots.push({ lat: state.pos.lat, lng: state.pos.lng, club: state.club, t: Date.now() });
        if (state.club !== "Putter") h.strokes = Math.max(h.strokes, h.shots.filter((s) => s.club !== "Putter").length);
        save(); render(); break;
      }
      case "btn-undo-shot": r.players[state.sel].holes[state.hole].shots.pop(); save(); render(); break;
      case "btn-finish":
        r.done = true; state.data.activeRoundId = null; save();
        if (r.players.length > 1) { state.lastFinished = r.id; state.tab = "ronda"; } else state.tab = "historial";
        render(); break;
      case "btn-discard": $("#discard-confirm").hidden = false; break;
      case "discard-no": $("#discard-confirm").hidden = true; break;
      case "discard-yes": state.data.rounds = state.data.rounds.filter((x) => x.id !== r.id); state.data.activeRoundId = null; save(); render(); break;
      case "btn-save-profile": {
        const p = state.data.profile;
        p.name = $("#pf-name").value.trim();
        const hc = parseNum($("#pf-hcp").value); if (hc !== null) p.handicap = hc;
        p.level = $("#pf-level").value;
        save(); $("#pf-saved").hidden = false; break;
      }
      case "btn-clear-examples":
        state.data.courses = state.data.courses.filter((x) => !x.example);
        state.data.rounds = state.data.rounds.filter((x) => !x.example && state.data.courses.some((c) => c.id === x.courseId));
        if (!activeRound()) state.data.activeRoundId = null;
        save(); render(); break;
    }
  });
  document.addEventListener("change", (e) => {
    const t = e.target;
    if (t.id === "club") state.club = t.value;
    if (t.id === "nc-holes") { state.newCourseHoles = parseInt(t.value, 10); state.newCourseName = $("#nc-name").value; render(); }
    if (t.dataset.par !== undefined) state.newCoursePars[+t.dataset.par] = parseInt(t.value, 10);
  });

  if (location.hash === "#debug") window.__state = state;
  // Si había una ronda en curso, volver al hoyo donde quedó
  const ar = activeRound();
  if (ar) { const k = meOf(ar).holes.findIndex((h) => !h.strokes); state.hole = k === -1 ? ar.players[0].holes.length - 1 : k; }
  render();
})();
</script>

