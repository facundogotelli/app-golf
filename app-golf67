    const single = r.players.length === 1;
    return `<div class="card-scroll">${halves.map(([a, b]) => {
      const idx = Array.from({ length: b - a }, (_, k) => a + k);
      const sum = (f) => idx.reduce((t, k) => t + f(k), 0);
      const totalHead = a === 0 ? (b === 9 ? "Ida" : "Tot") : "Vta";
      const rows = r.players.map((p) => `<tr><th title="${esc(p.name)}">${esc(single ? "Golpes" : p.name)}</th>${idx.map((k) => {
          const st = p.holes[k].strokes, d = st - c.pars[k];
          const cls = [live && k === state.hole ? "cur" : "", st ? (d < 0 ? "birdie" : d > 0 ? "bogey" : "") : ""].join(" ");
          return `<td class="${cls}">${st || ""}</td>`;
        }).join("")}<td>${sum((k) => p.holes[k].strokes) || ""}</td></tr>`).join("");
      const me = meOf(r);
      const putts = single ? `<tr><th>Putts</th>${idx.map((k) => `<td>${me.holes[k].strokes ? me.holes[k].putts : ""}</td>`).join("")}<td>${sum((k) => me.holes[k].putts) || ""}</td></tr>` : "";
      return `<table class="score" style="margin-bottom:8px">
        <tr><th>Hoyo</th>${idx.map((k) => `<th>${k + 1}</th>`).join("")}<th>${totalHead}</th></tr>
        <tr><th>Par</th>${idx.map((k) => `<td>${c.pars[k]}</td>`).join("")}<td>${sum((k) => c.pars[k])}</td></tr>
        ${rows}${putts}
      </table>`;
    }).join("")}</div>`;
  }

  // Resultado de la ronda: gross y neto de cada jugador
  function leaderboard(r) {
    const c = courseOf(r);
    return r.players.map((p) => {
      const s = playerStats(p.holes, c.pars);
      const net = s.strokes - strokesAllowance(p.handicap, s.played);
      return { name: p.name, gross: s.strokes, toPar: s.toPar, net, played: s.played };
    }).sort((a, b) => a.net - b.net || a.gross - b.gross);
  }
  function viewResults(roundId) {
    const r = state.data.rounds.find((x) => x.id === roundId);
    if (!r || r.players.length < 2) return "";
    const rows = leaderboard(r);
    return `<section class="panel">
      <div class="row between"><h2>Resultado de la ronda</h2><button class="link" id="btn-close-results">Cerrar</button></div>
      ${boardTable(rows)}
    </section>`;
  }
  function boardTable(rows) {
    return `<table class="board">
      <tr><th class="label"></th><th class="label" style="text-align:left">Jugador</th><th class="label">Gross</th><th class="label">Neto</th></tr>
      ${rows.map((x, k) => `<tr><td class="pos">${k + 1}</td><td style="text-align:left">${esc(x.name)}${x.played < 18 && x.played ? ` <span class="muted small">(${x.played} hoyos)</span>` : ""}</td>
        <td class="big">${x.gross || "–"} <span class="muted small">${x.gross ? signed(x.toPar) : ""}</span></td><td class="big">${x.gross ? x.net : "–"}</td></tr>`).join("")}
    </table>
    <p class="muted small">Neto = golpes menos el handicap de cada jugador. Es aproximado: no ajusta por slope ni por la dificultad de cada hoyo.</p>`;
  }

  /* ---------- Historial ---------- */
  function viewHistory() {
    const done = state.data.rounds.filter((r) => r.done).sort((a, b) => b.date.localeCompare(a.date));
    const p = state.data.profile;
    if (!done.length) return `<header><h1>Historial</h1></header><section class="panel"><p class="muted">Todavía no terminaste ninguna ronda. Cuando termines la primera, vas a ver acá tus estadísticas y cómo jugaste según tu handicap.</p></section>`;
    const full = done.filter(isFull).map((r) => ({ r, s: roundStats(r) }));
    const avg = (f) => full.length ? full.reduce((t, x) => t + f(x), 0) / full.length : 0;
    const fwPct = (() => { const t = full.reduce((a, x) => a + x.s.fwTotal, 0); return t ? Math.round(100 * full.reduce((a, x) => a + x.s.fw, 0) / t) : null; })();
    const girPct = (() => { const t = full.reduce((a, x) => a + x.s.played, 0); return t ? Math.round(100 * full.reduce((a, x) => a + x.s.gir, 0) / t) : null; })();
    const hi = handicapIndex();
    const last = full[0];
    const lastHcp = last ? (meOf(last.r).handicap ?? p.handicap) : 0;
    const expected = last ? last.s.par + strokesAllowance(lastHcp, last.s.played) : null;
    const anyExample = done.some((r) => r.example);
    const clubs = clubDistances();
    return `
      <header class="row between"><h1>Historial</h1>${anyExample ? `<span class="pill">Incluye ejemplos</span>` : ""}</header>
      ${last ? `<section class="panel">
        <span class="label">Última ronda · ${fmtDate(last.r.date)}</span>
        <div class="row between"><h2>${esc(courseOf(last.r).name)}</h2><span class="num" style="font-size:34px;font-weight:700">${last.s.strokes}</span></div>
        <p>Con handicap ${lastHcp}, lo esperado era unos <b class="num">${expected}</b> golpes.
          ${last.s.strokes <= expected ? `<span class="pill good">${expected - last.s.strokes} golpes mejor</span>` : `<span class="pill bad">${last.s.strokes - expected} golpes arriba</span>`}</p>
        <p class="muted">${insight(last.s, p)}</p>
        ${last.r.players.length > 1 ? boardTable(leaderboard(last.r)) : ""}
      </section>` : ""}

      <section class="panel">
        <h2>Evolución del score</h2>
        <p class="muted small">Rondas completas de 18 hoyos.</p>
        ${scoreChart(full.slice().reverse())}
      </section>

      <section class="panel">
        <h2>Promedios</h2>
        <div class="stats">
          <div class="stat"><span class="label">Score</span><span class="v">${full.length ? avg((x) => x.s.strokes).toFixed(1) : "–"}</span></div>
          <div class="stat"><span class="label">Putts</span><span class="v">${full.length ? avg((x) => x.s.putts).toFixed(1) : "–"}</span></div>
          <div class="stat"><span class="label">Fairways</span><span class="v">${fwPct !== null ? fwPct + "%" : "–"}</span></div>
          <div class="stat"><span class="label">Greens en regulación</span><span class="v">${girPct !== null ? girPct + "%" : "–"}</span></div>
          <div class="stat"><span class="label">Handicap estimado</span><span class="v">${hi.value !== null ? hi.value.toFixed(1) : "–"}</span>
            <span class="muted small">${hi.value !== null ? `con ${hi.n} rondas` : `faltan ${Math.max(0, 3 - hi.n)} rondas de 18 hoyos con rating y slope`}</span></div>
        </div>
        <p class="muted small">El handicap estimado usa la fórmula del sistema mundial (WHS). No es oficial: el oficial lo lleva la asociación de golf de tu país.</p>
      </section>

      <section class="panel">
        <h2>Distancia por palo</h2>
        ${clubs.length ? clubChart(clubs) : `<p class="muted">Registrá tus tiros durante la ronda para ver cuántas yardas le pegás con cada palo.</p>`}
      </section>

      <section class="panel">
        <h2>Rondas</h2>
        <ul class="round-list">${done.map((r) => {
          const s = roundStats(r), n = courseOf(r).pars.length;
          const others = r.players.length > 1 ? ` · con ${r.players.filter((x) => !x.isMe).map((x) => esc(x.name)).join(", ")}` : "";
          return `<li>
          <span><b>${esc(courseOf(r).name)}</b>${r.example ? ` <span class="pill">Ejemplo</span>` : ""}</span>
          <span class="round-score">${s.strokes}</span>
          <span class="muted small">${fmtDate(r.date)} · ${signed(s.toPar)} · ${s.putts} putts${s.played < n ? ` · ${s.played} de ${n} hoyos` : ""}${others}</span></li>`; }).join("")}</ul>
      </section>`;
  }

  // Gráfico de línea del score de cada ronda completa
  function scoreChart(rounds) {
    if (rounds.length < 2) return `<p class="muted">Cuando tengas 2 rondas completas de 18 hoyos, acá vas a ver si tu score baja.</p>`;
    const pts = rounds.slice(-15).map((x) => ({ v: x.s.strokes, toPar: x.s.toPar, date: x.r.date, course: courseOf(x.r).name }));
    const W = 340, H = 170, L = 30, R = 34, T = 12, B = 26;
    const vals = pts.map((p) => p.v);
    let lo = Math.floor((Math.min(...vals) - 2) / 5) * 5, hi = Math.ceil((Math.max(...vals) + 2) / 5) * 5;
    if (hi - lo < 10) hi = lo + 10;
    const x = (k) => L + (pts.length === 1 ? 0 : k * (W - L - R) / (pts.length - 1));
    const y = (v) => T + (hi - v) * (H - T - B) / (hi - lo);
    const step = hi - lo > 30 ? 10 : 5; lo = Math.floor(lo / step) * step; hi = Math.ceil(hi / step) * step;
    const ticks = []; for (let t = lo; t <= hi; t += step) ticks.push(t);
    const path = pts.map((p, k) => `${k ? "L" : "M"}${x(k).toFixed(1)},${y(p.v).toFixed(1)}`).join(" ");
    const lastP = pts[pts.length - 1], first = pts[0];
    const delta = lastP.v - first.v;
    state.chartPts = pts;
    return `<div class="chart">
      <p class="small">${delta < 0 ? `<span class="pill good">${-delta} golpes menos</span> que en tu primera ronda del gráfico.` : delta > 0 ? `<span class="pill bad">${delta} golpes más</span> que en tu primera ronda del gráfico.` : "Mismo score que en tu primera ronda del gráfico."}</p>
      <svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Score de tus últimas ${pts.length} rondas, de ${first.v} a ${lastP.v} golpes">
        ${ticks.map((t) => `<line x1="${L}" x2="${W - R}" y1="${y(t)}" y2="${y(t)}" stroke="var(--grid)" stroke-width="1"/><text x="${L - 6}" y="${y(t) + 4}" text-anchor="end">${t}</text>`).join("")}
        <path d="${path}" fill="none" stroke="var(--fairway)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
        ${pts.map((p, k) => `<circle class="hit" data-pt="${k}" cx="${x(k)}" cy="${y(p.v)}" r="14"><title>${fmtShort(p.date)}: ${p.v} golpes</title></circle><circle class="pt" data-ptv="${k}" cx="${x(k)}" cy="${y(p.v)}" r="4" fill="var(--fairway)" stroke="var(--surface)" stroke-width="2" pointer-events="none"/>`).join("")}
        <text class="endlabel" x="${x(pts.length - 1) + 8}" y="${y(lastP.v) + 5}">${lastP.v}</text>
        <text x="${x(0)}" y="${H - 6}" text-anchor="start">${fmtShort(first.date)}</text>
        <text x="${x(pts.length - 1)}" y="${H - 6}" text-anchor="end">${fmtShort(lastP.date)}</text>
      </svg>
      <p class="tip muted" id="chart-tip">Tocá un punto para ver la ronda.</p>
    </div>`;
  }
  function bindChart() {
    const tip = $("#chart-tip");
    if (!tip) return;
    const show = (k) => {
      const p = state.chartPts[k];
      document.querySelectorAll(".chart .pt").forEach((c) => c.classList.toggle("active", c.dataset.ptv === String(k)));
      tip.innerHTML = `<b>${fmtDate(p.date)}</b> · ${esc(p.course)} · <b class="num">${p.v}</b> golpes (${signed(p.toPar)})`;
    };
    document.querySelectorAll(".chart .hit").forEach((el) => {
      el.addEventListener("mouseenter", () => show(+el.dataset.pt));
      el.addEventListener("click", () => show(+el.dataset.pt));
    });
  }
  function clubChart(clubs) {
    const max = Math.max(...clubs.map((c) => c.max));
    return `<div class="clubs">${clubs.map((c) => `<div class="club" title="${esc(c.club)}: promedio ${c.avg} yd, máximo ${c.max} yd, ${c.n} tiros">
      <span class="name">${esc(c.club)}</span>
      <div class="track"><div class="bar" style="width:${(100 * c.avg / max).toFixed(1)}%"></div></div>
      <span class="yd">${c.avg}</span>
      <span class="sub">máx. ${c.max} yd · ${c.n} ${c.n === 1 ? "tiro" : "tiros"}</span>
    </div>`).join("")}</div>
    <p class="muted small">Promedio en yardas, de cada tiro registrado al siguiente. Si un tiro no se registró, el anterior queda más largo: borralo desde el hoyo.</p>`;
  }

  function insight(s, p) {
    const puttsPerHole = s.putts / s.played;
    const target = p.level === "principiante" ? 2.1 : p.level === "avanzado" ? 1.75 : 1.9;
    if (puttsPerHole > target + 0.1) return `Tus putts (${s.putts}) están por encima de lo habitual para tu nivel. Practicar putts de 1 a 2 metros es lo que más golpes te puede ahorrar.`;
    if (s.fwTotal && s.fw / s.fwTotal < 0.4) return `Acertaste ${s.fw} de ${s.fwTotal} fairways. Probá con un palo más corto desde el tee en los hoyos angostos.`;
    if (s.gir / s.played < 0.2) return `Llegaste a ${s.gir} greens en regulación. Trabajar los tiros de aproximación te va a dar más chances de birdie.`;
    return "Ronda pareja en todas las áreas del juego. Seguí registrando tiros para ver tu distancia real con cada palo.";
  }

  function viewProfile() {
    const p = state.data.profile;
    const hasExamples = state.data.rounds.some((r) => r.example) || state.data.courses.some((c) => c.example);
    return `
      <header><h1>Perfil</h1></header>
      <section class="panel">
        <label class="field" for="pf-name"><span class="label">Nombre</span><input id="pf-name" value="${esc(p.name)}" placeholder="Tu nombre"></label>
        <div class="row">
          <label class="field" for="pf-hcp"><span class="label">Handicap</span><input id="pf-hcp" inputmode="decimal" value="${p.handicap}"></label>
          <label class="field" for="pf-level"><span class="label">Nivel</span>
            <select id="pf-level">${["principiante", "intermedio", "avanzado"].map((l) => `<option value="${l}" ${p.level === l ? "selected" : ""}>${l[0].toUpperCase() + l.slice(1)}</option>`).join("")}</select></label>
        </div>
        <button class="primary" id="btn-save-profile">Guardar perfil</button>
        <span class="muted small" id="pf-saved" hidden>Perfil guardado.</span>
      </section>
      <section class="panel">
        <h2>Canchas guardadas</h2>
        <ul class="results">${state.data.courses.map((c) => `<li><span><b>${esc(c.name)}</b><br><span class="muted small">${c.pars.length} hoyos · par ${c.pars.reduce((a, b) => a + b, 0)} · ${c.source === "osm" ? "del mapa" : "cargada a mano"}</span></span></li>`).join("")}</ul>
      </section>
      ${hasExamples ? `<section class="panel">
        <h2>Datos de ejemplo</h2>
        <p class="muted">La app trae una cancha y rondas de ejemplo para que veas cómo funciona. Borralos cuando cargues tus propias rondas.</p>
        <button id="btn-clear-examples">Borrar datos de ejemplo</button>
      </section>` : ""}
      <section class="panel">
        <h2>Tus datos</h2>
        <p class="muted">Todo se guarda solo en este celular, en este navegador. Si borrás los datos del navegador, se pierde el historial.</p>
      </section>`;
  }

  /* ================= Mapa ================= */
  function setupMap() {
    const el = $("#map"), note = $("#map-note");
    if (!el) return;
    if (typeof L === "undefined") { el.hidden = true; note.textContent = "El mapa no se pudo cargar. Revisá tu conexión."; return; }
    const r = activeRound(), c = courseOf(r), i = state.hole, g = c.greens[i], line = c.holeLines[i];
    map = L.map(el, { zoomControl: true, attributionControl: true });
    if (line && line.length > 1) map.fitBounds(L.latLngBounds(line.map((p) => [p.lat, p.lng])).pad(0.15));
    else { const center = g || state.pos || { lat: -34.6037, lng: -58.3816 }; map.setView([center.lat, center.lng], g || state.pos ? 17 : 12); }
    const tiles = L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", {
      maxZoom: 20, maxNativeZoom: 19, attribution: "Imágenes © Esri · Canchas © OpenStreetMap",
    }).addTo(map);
    let errors = 0;
    tiles.on("tileerror", () => { if (++errors > 3 && !tilesFailed) { tilesFailed = true; note.textContent = "Las imágenes satelitales no cargan en esta vista. En tu link de GitHub sí se ven."; } });
    mapLayers = L.layerGroup().addTo(map);
    map.on("click", (e) => {
      if (!state.setGreenMode) return;
      const pt = { lat: e.latlng.lat, lng: e.latlng.lng };
      // Si hay contorno y se toca adentro, se mueve solo la bandera; si se toca afuera, se descarta el contorno
      if (c.greenPolys[i] && !pointInPoly(pt, c.greenPolys[i])) delete c.greenPolys[i];
      c.greens[i] = pt;
      state.setGreenMode = false; save(); render();
    });
    drawMap();
    if (!tilesFailed) note.textContent = g ? "" : "Tocá «Marcar el green» y después el green en el mapa.";
  }
  function drawMap() {
    draw3D();
    if (!map || !mapLayers) return;
    mapLayers.clearLayers();
    const r = activeRound(), c = courseOf(r), i = state.hole, h = r.players[state.sel].holes[i], g = c.greens[i];
    if (c.holeLines[i]) L.polyline(c.holeLines[i].map((p) => [p.lat, p.lng]), { color: "#FFFFFF", weight: 2, opacity: 0.7, dashArray: "2 6" }).addTo(mapLayers);
    if (c.greenPolys[i]) L.polygon(c.greenPolys[i].map((p) => [p.lat, p.lng]), { color: "#E2B529", weight: 2, fillOpacity: 0.12 }).addTo(mapLayers);
    const pts = h.shots.map((s) => [s.lat, s.lng]);
    if (pts.length) L.polyline(pts.concat(g ? [[g.lat, g.lng]] : []), { color: "#E2B529", weight: 3, dashArray: "6 6" }).addTo(mapLayers);
    h.shots.forEach((s, k) => L.circleMarker([s.lat, s.lng], { radius: 6, color: "#FFFFFF", weight: 2, fillColor: "#1F6B3A", fillOpacity: 1 }).bindTooltip(`Tiro ${k + 1}: ${s.club}`).addTo(mapLayers));
    if (g) {
      if (!c.greenPolys[i]) L.circle([g.lat, g.lng], { radius: 14, color: "#E2B529", weight: 2, fillOpacity: 0.12 }).addTo(mapLayers);
      L.circleMarker([g.lat, g.lng], { radius: 5, color: "#E2B529", fillColor: "#E2B529", fillOpacity: 1 }).bindTooltip("Bandera").addTo(mapLayers);
    }
    if (state.pos) L.circleMarker([state.pos.lat, state.pos.lng], { radius: 8, color: "#FFFFFF", weight: 3, fillColor: "#2F7DE1", fillOpacity: 1 }).bindTooltip("Vos").addTo(mapLayers);
  }

  /* ================= Vista 3D (relieve + satélite, sin costo) ================= */
  let map3d = null, mlPromise = null;
  function loadMapLibre() {
    if (window.maplibregl) return Promise.resolve();
    if (!mlPromise) mlPromise = new Promise((res, rej) => {
      const sc = document.createElement("script");
      sc.src = MAPLIBRE_JS; sc.onload = res; sc.onerror = () => { mlPromise = null; rej(new Error("no cargó")); };
      document.head.appendChild(sc);
    });
    return mlPromise;
  }
  function holeGeo() {
    const r = activeRound(), c = courseOf(r), i = state.hole, h = r.players[state.sel].holes[i];
    const line = c.holeLines[i];
    const green = c.greens[i] || null;
    const tee = (line && line[0]) || (h.shots[0]) || state.pos || null;
    return { r, c, i, h, line, green, tee, poly: c.greenPolys[i] };
  }
  const ll = (p) => [p.lng, p.lat];
  const fc = (features) => ({ type: "FeatureCollection", features });
  const feat = (geometry, properties = {}) => ({ type: "Feature", geometry, properties });
  async function setup3D() {
    const el = $("#map"), note = $("#map-note");
    if (!el) return;
    note.textContent = "Cargando la vista 3D…";
    try { await loadMapLibre(); } catch (e) { note.textContent = "No se pudo cargar la vista 3D. Revisá tu conexión, o usá «Mapa»."; return; }
    if (!el.isConnected || state.data.prefs.mapMode !== "3d") return;
    const g = holeGeo();
    const start = g.green || g.tee || { lat: -34.6037, lng: -58.3816 };
    let m;
    try {
      m = new maplibregl.Map({
        container: el, center: ll(start), zoom: g.green || g.tee ? 16.5 : 11, pitch: 60, maxPitch: 75,
        attributionControl: { compact: false },
        style: {
          version: 8,
          sources: {
            sat: { type: "raster", tiles: [SAT_TILES], tileSize: 256, maxzoom: 19, attribution: "Imágenes © Esri" },
            dem: { type: "raster-dem", tiles: [DEM_TILES], tileSize: 256, maxzoom: 15, encoding: "terrarium", attribution: "Relieve © Mapzen/AWS · Canchas © OpenStreetMap" },
          },
          layers: [{ id: "sat", type: "raster", source: "sat" }],
          terrain: { source: "dem", exaggeration: 1.6 },
        },
      });
    } catch (e) { note.textContent = "Este celular no puede mostrar la vista 3D. Usá «Mapa»."; return; }
    map3d = m;
    let tileErrors = 0;
    m.on("error", () => { if (++tileErrors === 4) note.textContent = "El satélite o el relieve no cargan acá. En tu link de GitHub sí se ven."; });
    m.on("load", () => {
      if (map3d !== m) return;
      ["hole", "green", "shots", "pts", "flag", "me"].forEach((id) => m.addSource(id, { type: "geojson", data: fc([]) }));
      m.addLayer({ id: "hole", type: "line", source: "hole", paint: { "line-color": "#FFFFFF", "line-width": 2, "line-opacity": 0.8, "line-dasharray": [1, 2] } });
      m.addLayer({ id: "green-fill", type: "fill", source: "green", paint: { "fill-color": "#E2B529", "fill-opacity": 0.18 } });
      m.addLayer({ id: "green-line", type: "line", source: "green", paint: { "line-color": "#E2B529", "line-width": 2 } });
      m.addLayer({ id: "shots", type: "line", source: "shots", paint: { "line-color": "#FFD23F", "line-width": 3, "line-dasharray": [2, 2] } });
      m.addLayer({ id: "pts", type: "circle", source: "pts", paint: { "circle-radius": 6, "circle-color": "#1F6B3A", "circle-stroke-color": "#FFFFFF", "circle-stroke-width": 2 } });
      m.addLayer({ id: "flag", type: "circle", source: "flag", paint: { "circle-radius": 6, "circle-color": "#E2B529", "circle-stroke-color": "#1E1A08", "circle-stroke-width": 1.5 } });
      m.addLayer({ id: "me", type: "circle", source: "me", paint: { "circle-radius": 8, "circle-color": "#2F7DE1", "circle-stroke-color": "#FFFFFF", "circle-stroke-width": 3 } });
      draw3D(); frameHole(false);
      if (tileErrors < 4) note.textContent = g.green ? "Arrastrá con dos dedos para inclinar o girar." : "Tocá «Marcar el green» y después el green en el mapa.";
    });
    m.on("click", (e) => {
      if (!state.setGreenMode) return;
      const c = courseOf(activeRound()), i = state.hole, pt = { lat: e.lngLat.lat, lng: e.lngLat.lng };
      if (c.greenPolys[i] && !pointInPoly(pt, c.greenPolys[i])) delete c.greenPolys[i];
      c.greens[i] = pt; state.setGreenMode = false; save(); render();
    });
  }
  function draw3D() {
    const m = map3d;
    if (!m || !m.getSource || !m.getSource("hole")) return;
    const g = holeGeo();
    const holeLine = g.line && g.line.length > 1 ? g.line : (g.tee && g.green ? [g.tee, g.green] : null);
    m.getSource("hole").setData(fc(holeLine ? [feat({ type: "LineString", coordinates: holeLine.map(ll) })] : []));
