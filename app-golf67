<style>
/* Layout: una libreta de yardas de bolsillo. Encabezado del hoyo arriba, distancia grande, score de cada jugador abajo, pestañas fijas al pie. */
:root {
  --bg: #F3F5EF;
  --surface: #FFFFFF;
  --ink: #17251B;
  --muted: #5E6B60;
  --line: #D7DDD2;
  --fairway: #1F6B3A;
  --fairway-ink: #FFFFFF;
  --flag: #E2B529;
  --flag-ink: #1E1A08;
  --sand: #EDE3C8;
  --good: #1F7A45;
  --bad: #B3402C;
  --grid: #E6EAE2;
  --font-num: "Barlow Condensed", "Arial Narrow", "Roboto Condensed", sans-serif;
  --font-body: "Source Sans 3", "Segoe UI", system-ui, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0F1712; --surface: #17221B; --ink: #E7EEE6; --muted: #9AA99C; --line: #2A3A2F;
    --fairway: #3E9E62; --fairway-ink: #08130C; --flag: #EFC646; --flag-ink: #1E1A08; --sand: #3A3524;
    --good: #5CC489; --bad: #E77A63; --grid: #223027;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0F1712; --surface: #17221B; --ink: #E7EEE6; --muted: #9AA99C; --line: #2A3A2F;
  --fairway: #3E9E62; --fairway-ink: #08130C; --flag: #EFC646; --flag-ink: #1E1A08; --sand: #3A3524;
  --good: #5CC489; --bad: #E77A63; --grid: #223027;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body { background: var(--bg); color: var(--ink); font-family: var(--font-body); font-size: 16px; line-height: 1.45; }
.wrap {
  max-width: 560px; margin: 0 auto;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 12px calc(84px + env(safe-area-inset-bottom, 0px));
  display: flex; flex-direction: column; gap: 14px;
}
h1, h2, h3 { margin: 0; text-wrap: balance; }
h1 { font-family: var(--font-num); font-weight: 700; font-size: 28px; letter-spacing: .02em; }
h2 { font-family: var(--font-num); font-weight: 600; font-size: 22px; letter-spacing: .02em; }
p { margin: 0; }
.label { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; }
.muted { color: var(--muted); }
.small { font-size: 13px; }
.num { font-family: var(--font-num); font-variant-numeric: tabular-nums; }
.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.row.between { justify-content: space-between; }
button, select, input { font: inherit; color: inherit; }
button { border: 1px solid var(--line); background: var(--surface); border-radius: 10px; padding: 10px 14px; cursor: pointer; font-weight: 600; }
button.primary { background: var(--fairway); color: var(--fairway-ink); border-color: var(--fairway); }
button.flag { background: var(--flag); color: var(--flag-ink); border-color: var(--flag); }
button.ghost { background: transparent; }
button.link { border: 0; background: transparent; padding: 4px 6px; color: var(--fairway); text-decoration: underline; }
button:disabled { opacity: .45; cursor: not-allowed; }
button:focus-visible, select:focus-visible, input:focus-visible { outline: 3px solid var(--flag); outline-offset: 2px; }
input, select { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 9px 10px; width: 100%; }
.field { display: flex; flex-direction: column; gap: 4px; flex: 1 1 140px; min-width: 0; }
.panel > .field, .pitem > .field { flex: none; }

/* Encabezado del hoyo */
.hole-head { background: var(--fairway); color: var(--fairway-ink); border-radius: 14px; padding: 14px 16px; display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; }
.hole-head .big { font-family: var(--font-num); font-size: 44px; line-height: 1; font-weight: 700; }
.hole-head .lbl { font-size: 11px; text-transform: uppercase; letter-spacing: .1em; opacity: .85; }
.hole-head button { background: transparent; color: inherit; border-color: color-mix(in srgb, var(--fairway-ink) 40%, transparent); padding: 8px 12px; font-size: 20px; line-height: 1; }
.hole-mid { text-align: center; min-width: 0; }

/* Distancia */
.dist { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; text-align: center; }
.dist .cell { display: flex; flex-direction: column; gap: 2px; }
.dist .val { font-family: var(--font-num); font-size: 40px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
.dist .cell.main .val { font-size: 56px; color: var(--fairway); }
.gps-status { font-size: 13px; display: flex; gap: 6px; align-items: center; }
.dot { width: 9px; height: 9px; border-radius: 50%; background: var(--muted); flex: none; }
.dot.on { background: var(--good); }
.dot.off { background: var(--bad); }
#map { height: 260px; border-radius: 10px; overflow: hidden; border: 1px solid var(--line); background: var(--sand); }

/* Jugadores en el hoyo */
.players { display: flex; flex-direction: column; }
.phead, .prow { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 8px; align-items: center; }
.phead { padding-bottom: 4px; border-bottom: 1px solid var(--line); }
.phead .label { text-align: center; }
.prow { padding: 8px 0; border-bottom: 1px solid var(--line); }
.prow:last-child { border-bottom: 0; }
.pname { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-width: 0; border: 0; background: transparent; padding: 4px 6px; border-radius: 8px; text-align: left; }
.pname .n { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
.pname[aria-pressed="true"] { background: color-mix(in srgb, var(--fairway) 14%, transparent); }
.stepper { display: flex; align-items: center; gap: 2px; }
.stepper button { width: 38px; height: 40px; padding: 0; font-size: 22px; line-height: 1; }
.stepper .v { font-family: var(--font-num); font-size: 28px; font-weight: 700; min-width: 28px; text-align: center; font-variant-numeric: tabular-nums; }
.seg { display: flex; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
.seg button { border: 0; border-radius: 0; flex: 1; background: transparent; }
.seg button[aria-pressed="true"] { background: var(--fairway); color: var(--fairway-ink); }

/* Tiros */
.shots { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; list-style: none; }
.shots li { display: grid; grid-template-columns: 28px 1fr auto; gap: 8px; align-items: center; padding: 6px 0; border-bottom: 1px dashed var(--line); }
.shots li:last-child { border-bottom: 0; }
.shot-n { font-family: var(--font-num); font-weight: 700; color: var(--muted); }

/* Tarjeta */
.card-scroll { overflow-x: auto; }
table.score { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; min-width: 340px; }
table.score th, table.score td { border: 1px solid var(--line); padding: 5px 4px; text-align: center; font-family: var(--font-num); font-size: 17px; }
table.score th { font-size: 12px; color: var(--muted); font-family: var(--font-body); font-weight: 600; letter-spacing: .03em; max-width: 72px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
table.score td.cur { outline: 2px solid var(--flag); outline-offset: -2px; }
.birdie { color: var(--good); font-weight: 700; }
.bogey { color: var(--bad); }

/* Estadísticas */
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 8px; }
.stat { border: 1px solid var(--line); border-radius: 10px; padding: 10px; display: flex; flex-direction: column; gap: 2px; }
.stat .v { font-family: var(--font-num); font-size: 30px; font-weight: 700; line-height: 1.05; font-variant-numeric: tabular-nums; }
.pill { display: inline-block; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: var(--sand); color: var(--ink); white-space: nowrap; }
.pill.good { background: color-mix(in srgb, var(--good) 18%, transparent); color: var(--good); }
.pill.bad { background: color-mix(in srgb, var(--bad) 16%, transparent); color: var(--bad); }
.chart svg { display: block; width: 100%; height: auto; overflow: visible; }
.chart text { font-family: var(--font-body); font-size: 11px; fill: var(--muted); }
.chart .endlabel { font-family: var(--font-num); font-size: 15px; font-weight: 700; fill: var(--ink); }
.chart .hit { fill: transparent; cursor: pointer; }
.chart .hit:hover + .pt, .chart .pt.active { r: 6; }
.tip { font-size: 13px; min-height: 1.4em; }
.clubs { display: flex; flex-direction: column; gap: 8px; }
.club { display: grid; grid-template-columns: 76px minmax(0, 1fr) 58px; gap: 8px; align-items: center; }
.club .name { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.club .track { height: 14px; background: var(--grid); border-radius: 0 4px 4px 0; position: relative; }
.club .bar { height: 100%; background: var(--fairway); border-radius: 0 4px 4px 0; }
.club .yd { font-family: var(--font-num); font-size: 20px; font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; }
.club .sub { grid-column: 2 / 4; font-size: 12px; color: var(--muted); margin-top: -6px; }

.round-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
