<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
(function () {
  "use strict";

  /* ================= Utilidades ================= */
  const M_TO_YD = 1.09361;
  const MAX_PLAYERS = 5;
  const CLUBS = ["Driver", "Madera 3", "Madera 5", "Híbrido", "Hierro 4", "Hierro 5", "Hierro 6", "Hierro 7", "Hierro 8", "Hierro 9", "PW", "GW", "SW", "LW", "Putter"];
  const MAPLIBRE_JS = "https://cdn.jsdelivr.net/npm/maplibre-gl@4.7.1/dist/maplibre-gl.js";
  const SAT_TILES = "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}";
  const DEM_TILES = "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png";
  const TRACE_COLORS = { Amarillo: "#FFD23F", Rojo: "#FF3B30", Blanco: "#FFFFFF", Celeste: "#4FC3F7" };
  const OVERPASS = ["https://overpass-api.de/api/interpreter", "https://overpass.kumi.systems/api/interpreter"];
  const $ = (sel) => document.querySelector(sel);
  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const uid = () => Math.random().toString(36).slice(2, 10);
  const yd = (m) => Math.round(m * M_TO_YD);
  const fmtDate = (iso) => new Date(iso).toLocaleDateString("es-AR", { day: "numeric", month: "short", year: "numeric" });
  const fmtShort = (iso) => new Date(iso).toLocaleDateString("es-AR", { day: "numeric", month: "short" });
  const signed = (n) => (n > 0 ? "+" + n : n === 0 ? "E" : String(n));
  const parseNum = (v) => { const n = parseFloat(String(v ?? "").replace(",", ".")); return isNaN(n) ? null : n; };

  // Distancia entre dos puntos GPS (Haversine), en metros
  function distanceM(a, b) {
    const R = 6371000, rad = Math.PI / 180;
    const dLat = (b.lat - a.lat) * rad, dLng = (b.lng - a.lng) * rad;
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(a.lat * rad) * Math.cos(b.lat * rad) * Math.sin(dLng / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  }
  // Proyección local en metros alrededor de un origen (suficiente para distancias de una cancha)
  function toXY(origin, p) {
    const k = Math.PI / 180 * 6371000;
    return { x: (p.lng - origin.lng) * k * Math.cos(origin.lat * Math.PI / 180), y: (p.lat - origin.lat) * k };
  }
  function bearingDeg(a, b) {
    const r = Math.PI / 180, dL = (b.lng - a.lng) * r;
    const y = Math.sin(dL) * Math.cos(b.lat * r);
    const x = Math.cos(a.lat * r) * Math.sin(b.lat * r) - Math.sin(a.lat * r) * Math.cos(b.lat * r) * Math.cos(dL);
    return (Math.atan2(y, x) / r + 360) % 360;
  }
  function circlePoly(c, radiusM, n = 28) {
    return Array.from({ length: n + 1 }, (_, k) => {
      const a = (k % n) / n * 2 * Math.PI;
      return { lat: c.lat + (radiusM * Math.cos(a)) / 111195, lng: c.lng + (radiusM * Math.sin(a)) / (111195 * Math.cos(c.lat * Math.PI / 180)) };
    });
  }
  function pointInPoly(pt, poly) {
    let inside = false;
    for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
      const a = poly[i], b = poly[j];
      if ((a.lat > pt.lat) !== (b.lat > pt.lat) && pt.lng < (b.lng - a.lng) * (pt.lat - a.lat) / (b.lat - a.lat) + a.lng) inside = !inside;
    }
    return inside;
  }
  function centroid(poly) {
    const f = poly[0], l = poly[poly.length - 1];
    if (poly.length > 3 && f.lat === l.lat && f.lng === l.lng) poly = poly.slice(0, -1);
    const s = poly.reduce((t, p) => ({ lat: t.lat + p.lat, lng: t.lng + p.lng }), { lat: 0, lng: 0 });
    return { lat: s.lat / poly.length, lng: s.lng / poly.length };
  }
  // Distancia al borde más cercano (frente) y al punto más lejano (fondo) del contorno del green
  function polyFrontBack(pos, poly) {
    if (pointInPoly(pos, poly)) return { front: 0, back: Math.max(...poly.map((p) => distanceM(pos, p))) };
    let front = Infinity;
    for (let i = 0; i < poly.length; i++) {
      const a = toXY(pos, poly[i]), b = toXY(pos, poly[(i + 1) % poly.length]);
      const dx = b.x - a.x, dy = b.y - a.y, L = dx * dx + dy * dy;
      const t = L ? Math.max(0, Math.min(1, -(a.x * dx + a.y * dy) / L)) : 0;
      front = Math.min(front, Math.hypot(a.x + t * dx, a.y + t * dy));
    }
    return { front, back: Math.max(...poly.map((p) => distanceM(pos, p))) };
  }

  /* ================= Datos (guardados en este navegador) ================= */
  const KEY = "libreta-golf-v1";
  function load() {
    try { const raw = localStorage.getItem(KEY); if (raw) return JSON.parse(raw); } catch (e) { /* sin almacenamiento */ }
    return null;
  }
  function save() { try { localStorage.setItem(KEY, JSON.stringify(state.data)); } catch (e) { /* ignorar */ } }

  const EX_PARS = [4, 4, 3, 5, 4, 4, 3, 4, 5, 4, 3, 4, 5, 4, 4, 3, 4, 5];
  function exampleData() {
    const course = { id: "ej-cancha", name: "Cancha de ejemplo", pars: EX_PARS, rating: 71.2, slope: 125, greens: {}, greenPolys: {}, holeLines: {}, source: "manual", example: true };
    const mk = (daysAgo, scores, putts) => ({
      id: uid(), courseId: course.id, date: new Date(Date.now() - daysAgo * 864e5).toISOString(), done: true, example: true,
      players: [{ id: "me", name: "Vos", handicap: 18, isMe: true,
        holes: EX_PARS.map((p, i) => ({ strokes: scores[i], putts: putts[i], penalties: 0, fairway: p > 3 ? (i % 3 !== 0) : null, shots: [] })) }],
    });
    return {
      version: 2,
      profile: { name: "", handicap: 18, level: "intermedio" },
      courses: [course],
      rounds: [
        mk(35, [5, 6, 4, 6, 5, 5, 4, 5, 6, 5, 4, 6, 6, 5, 5, 4, 5, 7], [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 3]),
        mk(21, [5, 5, 4, 6, 5, 4, 3, 5, 6, 5, 4, 5, 6, 5, 4, 4, 5, 6], [2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]),
        mk(10, [5, 4, 3, 6, 5, 5, 4, 5, 5, 4, 4, 5, 6, 5, 5, 3, 5, 6], [2, 2, 1, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 1, 2, 2]),
        mk(3, [4, 5, 3, 5, 5, 4, 4, 4, 6, 5, 3, 5, 5, 4, 5, 4, 4, 6], [2, 2, 2, 1, 2, 2, 2, 1, 2, 2, 1, 2, 2, 2, 2, 2, 2, 2]),
      ],
      activeRoundId: null,
    };
  }
  // Tiros de ejemplo, para que la distancia por palo tenga algo que mostrar
  function addExampleShots(round) {
    const plan = { 3: ["Hierro 7"], 4: ["Driver", "Hierro 8"], 5: ["Driver", "Madera 3", "PW"] };
    const base = { Driver: 212, "Madera 3": 192, "Hierro 7": 138, "Hierro 8": 128, PW: 102 };
    let seed = round.date.length + new Date(round.date).getDate();
    const rnd = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };
    round.players[0].holes.forEach((h, i) => {
      if (h.shots.length) return;
      let p = { lat: -34.47 + i * 0.004, lng: -58.52 };
      (plan[EX_PARS[i]] || []).concat(["Putter"]).forEach((club) => {
        h.shots.push({ lat: p.lat, lng: p.lng, club, t: 0 });
        const m = ((base[club] || 0) + (rnd() - 0.5) * 24) / M_TO_YD;
        p = { lat: p.lat + m / 111195, lng: p.lng };
      });
    });
  }
  // Pasa los datos de la versión anterior (un solo jugador) al formato nuevo
  function migrate(d) {
    d.version = 2;
    d.courses.forEach((c) => { c.greens = c.greens || {}; c.greenPolys = c.greenPolys || {}; c.holeLines = c.holeLines || {}; c.source = c.source || "manual"; });
    d.rounds.forEach((r) => {
      if (!r.players) {
        r.players = [{ id: "me", name: "Vos", handicap: d.profile.handicap, isMe: true, holes: r.holes || [] }];
        delete r.holes;
      }
      if (r.example) addExampleShots(r);
    });
    return d;
  }

  const state = {
    data: migrate(load() || exampleData()),
    tab: "ronda",
    hole: 0,
    sel: 0,                // jugador seleccionado en el hoyo
    pos: null, gps: "idle",
    club: "Driver",
    setGreenMode: false,
    showNewCourse: false,
    guests: [],            // jugadores invitados para la próxima ronda
    cat: { items: [], status: "idle", filter: "", showAll: false, busyKey: null, msg: "", locating: false },
    catPos: null,
    changingCourse: false,
    lastFinished: null,
    view: "main",          // "main" o "tracer" (video del tiro)
    tracer: null,
  };
  state.data.prefs = state.data.prefs || { mapMode: "2d", traceColor: "Amarillo" };
  save();

  const activeRound = () => state.data.rounds.find((r) => r.id === state.data.activeRoundId) || null;
  const courseOf = (round) => state.data.courses.find((c) => c.id === round.courseId);
  const meOf = (round) => round.players.find((p) => p.isMe) || round.players[0];

  /* ================= GPS ================= */
  let watchId = null;
  function startGps() {
    if (watchId !== null) return;
    if (!("geolocation" in navigator)) { state.gps = "unavailable"; return; }
    try {
      watchId = navigator.geolocation.watchPosition(
        (p) => { state.pos = { lat: p.coords.latitude, lng: p.coords.longitude, acc: p.coords.accuracy }; state.gps = "on"; updateLive(); },
        (err) => { state.gps = err && err.code === 1 ? "denied" : "unavailable"; updateLive(); },
        { enableHighAccuracy: true, maximumAge: 2000, timeout: 20000 }
      );
    } catch (e) { state.gps = "unavailable"; }
  }
  function getPositionOnce() {
    return new Promise((resolve, reject) => {
      if (state.pos) return resolve(state.pos);
      if (!("geolocation" in navigator)) return reject(new Error("sin gps"));
      navigator.geolocation.getCurrentPosition((p) => resolve({ lat: p.coords.latitude, lng: p.coords.longitude }), reject, { enableHighAccuracy: false, timeout: 15000 });
    });
  }

  /* ================= Canchas desde OpenStreetMap ================= */
  async function overpass(query) {
    let lastErr;
    for (const url of OVERPASS) {
      try {
        const res = await fetch(url, { method: "POST", body: "data=" + encodeURIComponent(query), headers: { "Content-Type": "application/x-www-form-urlencoded" } });
        if (!res.ok) throw new Error("HTTP " + res.status);
        return await res.json();
      } catch (e) { lastErr = e; }
    }
    throw lastErr;
  }
  /* Catálogo: todas las canchas de Argentina en OpenStreetMap, guardado en el celular por 30 días */
  const CAT_KEY = "libreta-golf-catalogo-v1";
  const norm = (x) => String(x || "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  function readCatalog() { try { return JSON.parse(localStorage.getItem(CAT_KEY) || "null"); } catch (e) { return null; } }
  async function loadCatalog(force) {
    const cat = state.cat;
    const cached = readCatalog();
    if (!force && cached && cached.items && cached.items.length && Date.now() - cached.ts < 30 * 864e5) {
      cat.items = cached.items; cat.status = "ok"; renderCourseList(); return;
    }
    cat.status = "loading"; renderCourseList();
    try {
      const q = `[out:json][timeout:90];area["ISO3166-1"="AR"][admin_level=2]->.a;nwr["leisure"="golf_course"]["name"](area.a);out tags center;way["golf"="hole"](area.a);out center;`;
      const data = await overpass(q);
      const courses = [], holes = [];
      data.elements.forEach((e) => {
        const c = e.center || (e.lat ? { lat: e.lat, lon: e.lon } : null);
        if (!c || !e.tags) return;
        if (e.tags.leisure === "golf_course") courses.push({ key: e.type + "/" + e.id, type: e.type, id: e.id, name: e.tags.name,
          place: e.tags["addr:city"] || e.tags["is_in:city"] || e.tags["addr:state"] || "", lat: c.lat, lon: c.lon, refs: {} });
        else if (e.tags.golf === "hole") holes.push({ lat: c.lat, lng: c.lon, ref: e.tags.ref || e.id });
      });
      // Cada hoyo se asigna a la cancha más cercana (hasta 2 km)
      holes.forEach((h) => {
        let best = null, bd = 2000;
        courses.forEach((c) => { const d = distanceM(h, { lat: c.lat, lng: c.lon }); if (d < bd) { bd = d; best = c; } });
        if (best) best.refs[h.ref] = 1;
      });
      cat.items = courses.map((c) => ({ key: c.key, type: c.type, id: c.id, name: c.name, place: c.place, lat: c.lat, lon: c.lon, holes: Object.keys(c.refs).length }));
      cat.status = "ok";
      try { localStorage.setItem(CAT_KEY, JSON.stringify({ ts: Date.now(), items: cat.items })); } catch (e) { /* sin espacio */ }
    } catch (e) {
      cat.status = cached && cached.items ? "ok" : "error";
      if (cached && cached.items) cat.items = cached.items;
    }
    renderCourseList();
  }
  function locateForCatalog() {
    if (state.catPos || state.cat.locating) return;
    state.cat.locating = true;
    getPositionOnce().then((p) => { state.catPos = p; }).catch(() => {}).finally(() => { state.cat.locating = false; renderCourseList(); });
  }
  async function pickCatalogCourse(item) {
    const cat = state.cat;
    const saved = state.data.courses.find((c) => c.osm === item.key);
    if (saved) { selectCourse(saved.id); return; }
    cat.busyKey = item.key; cat.msg = `Cargando los hoyos de ${item.name}…`; renderCourseList();
    try {
      const r = { type: item.type, id: item.id, name: item.name, center: { lat: item.lat, lon: item.lon } };
      const sel = r.type === "node" ? `node(${r.id});` : `${r.type}(${r.id});map_to_area->.c;`;
      const inArea = r.type === "node" ? `(around:1500,${r.center.lat},${r.center.lon})` : "(area.c)";
      const q = `[out:json][timeout:40];${sel}(way["golf"="hole"]${inArea};way["golf"="green"]${inArea};relation["golf"="green"]${inArea};node["golf"="pin"]${inArea};);out geom;`;
      const data = await overpass(q);
      const course = buildCourse(r, data.elements);
      cat.busyKey = null;
      if (!course) {
        // Sin hoyos en el mapa: se abre la carga a mano con el nombre ya puesto
        cat.msg = `${item.name} está en el mapa pero sin los hoyos dibujados. Cargá los pares de la tarjeta acá abajo; los greens los marcás tocando el mapa la primera vez que la juegues.`;
        state.showNewCourse = true; state.newCourseName = item.name; state.newCourseOsm = item.key;
        render();
        const f = $("#nc-name"); if (f) f.scrollIntoView({ block: "center" });
        return;
      }
      state.data.courses.push(course); save();
      cat.msg = course.parsGuessed ? "Algunos pares no estaban en el mapa y quedaron en 4. Revisalos con la tarjeta del club." : "";
      selectCourse(course.id);
    } catch (e) {
      cat.busyKey = null; cat.msg = "No pude cargar los hoyos de esa cancha. Revisá tu conexión e intentá de nuevo.";
      renderCourseList();
    }
  }
  function selectCourse(id) {
    state.selectCourseId = id; state.changingCourse = false; state.cat.filter = ""; state.cat.showAll = false;
    render();
  }
  function wayPoints(el) {
    if (el.geometry) return el.geometry.map((g) => ({ lat: g.lat, lng: g.lon }));
    if (el.members) return el.members.filter((m) => m.role !== "inner" && m.geometry).flatMap((m) => m.geometry.map((g) => ({ lat: g.lat, lng: g.lon })));
    return [];
  }
  function simplify(pts, max) {
    if (pts.length <= max) return pts;
    const step = pts.length / max;
    return Array.from({ length: max }, (_, k) => pts[Math.floor(k * step)]);
  }
  function buildCourse(r, elements) {
    const byRef = new Map();
    elements.filter((e) => e.type === "way" && e.tags && e.tags.golf === "hole").forEach((e) => {
      const ref = parseInt(e.tags.ref, 10);
      if (!ref || byRef.has(ref)) return;
      const pts = wayPoints(e);
      if (pts.length < 2) return;
      byRef.set(ref, { pts, par: parseInt(e.tags.par, 10) || null });
    });
    if (!byRef.size) return null;
    const greens = elements.filter((e) => e.tags && e.tags.golf === "green").map((e) => wayPoints(e)).filter((p) => p.length >= 3);
    const pins = elements.filter((e) => e.type === "node" && e.tags && e.tags.golf === "pin").map((e) => ({ lat: e.lat, lng: e.lon }));
    const refs = [...byRef.keys()].sort((a, b) => a - b);
    const course = { id: uid(), name: r.name, pars: [], rating: null, slope: null, greens: {}, greenPolys: {}, holeLines: {}, source: "osm", osm: r.type + "/" + r.id };
    refs.forEach((ref, i) => {
      const h = byRef.get(ref);
      if (!h.par) course.parsGuessed = true;
      course.pars.push(h.par || 4);
      course.holeLines[i] = simplify(h.pts, 30);
      const end = h.pts[h.pts.length - 1];
      let poly = greens.find((g) => pointInPoly(end, g));
      if (!poly) {
        const near = greens.map((g) => ({ g, d: distanceM(end, centroid(g)) })).sort((a, b) => a.d - b.d)[0];
        if (near && near.d < 60) poly = near.g;
      }
      if (poly) {
        course.greenPolys[i] = simplify(poly, 60);
        course.greens[i] = pins.find((p) => pointInPoly(p, poly)) || centroid(poly);
      } else {
        course.greens[i] = end;
      }
    });
    return course;
  }

  /* ================= Estadísticas ================= */
  function playerStats(holes, pars) {
    let strokes = 0, putts = 0, par = 0, played = 0, fw = 0, fwTotal = 0, gir = 0;
    holes.forEach((h, i) => {
      if (!h.strokes) return;
      played++; strokes += h.strokes; putts += h.putts; par += pars[i];
      if (h.fairway === true || h.fairway === false) { fwTotal++; if (h.fairway) fw++; }
      if (h.strokes - h.putts <= pars[i] - 2) gir++;
    });
    return { strokes, putts, par, played, toPar: strokes - par, fw, fwTotal, gir };
  }
  const roundStats = (round) => playerStats(meOf(round).holes, courseOf(round).pars);
  const isFull = (round) => courseOf(round).pars.length === 18 && roundStats(round).played === 18;
  // Handicap de la ronda (aproximado): el índice escalado a la cantidad de hoyos
  const strokesAllowance = (hcp, nHoles) => Math.round((hcp || 0) * nHoles / 18);

  function differential(round) {
    const c = courseOf(round), me = meOf(round), s = roundStats(round);
    if (!c || !c.rating || !c.slope || s.played !== 18) return null;
    const extra = Math.round((me.handicap ?? state.data.profile.handicap ?? 0) / 18);
    const adj = me.holes.reduce((t, h, i) => t + Math.min(h.strokes, c.pars[i] + 2 + extra), 0);
    return (113 / c.slope) * (adj - c.rating);
  }
  function handicapIndex() {
    const diffs = state.data.rounds.filter((r) => r.done).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 20)
      .map(differential).filter((d) => d !== null).sort((a, b) => a - b);
    const n = diffs.length;
    if (n < 3) return { value: null, n };
    const table = { 3: [1, -2], 4: [1, -1], 5: [1, 0], 6: [2, -1], 7: [2, 0], 8: [2, 0], 9: [3, 0], 10: [3, 0], 11: [3, 0], 12: [4, 0], 13: [4, 0], 14: [4, 0], 15: [5, 0], 16: [5, 0], 17: [6, 0], 18: [6, 0], 19: [7, 0], 20: [8, 0] };
    const [take, adj] = table[n];
    const avg = diffs.slice(0, take).reduce((a, b) => a + b, 0) / take;
    return { value: Math.round((avg + adj) * 10) / 10, n };
  }
  // Distancia de cada palo: de un tiro registrado al siguiente, sin contar el putter
  function clubDistances() {
    const by = {};
    state.data.rounds.forEach((r) => meOf(r).holes.forEach((h) => {
      for (let k = 0; k < h.shots.length - 1; k++) {
        const s = h.shots[k];
        if (s.club === "Putter") continue;
        const d = yd(distanceM(s, h.shots[k + 1]));
        if (d < 5 || d > 400) continue;
        (by[s.club] = by[s.club] || []).push(d);
      }
    }));
    return CLUBS.filter((c) => by[c]).map((club) => {
      const arr = by[club];
      return { club, avg: Math.round(arr.reduce((a, b) => a + b, 0) / arr.length), max: Math.max(...arr), n: arr.length };
    });
  }

